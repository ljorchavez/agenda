# Copy to apps/api/.env for local development

DATABASE_URL=postgres://agenda:agenda@localhost:5432/agenda
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=3000
# Public URL of the web app (used in links sent to customers)
APP_URL=http://localhost:5173

# WhatsApp Cloud API (leave empty to log messages instead of sending them)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_REMINDER_TEMPLATE=appointment_reminder
WHATSAPP_TEMPLATE_LANG=es_MX

# Mercado Pago (platform-level test credentials; per-tenant OAuth comes later)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Transactional email (password reset) through Resend. Without them nothing is sent.
RESEND_API_KEY=
EMAIL_FROM="Agenda <no-reply@tudominio.mx>"
